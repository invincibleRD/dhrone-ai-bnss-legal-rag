{
  "name": "rag-backend",
  "version": "1.0.0",
  "description": "Simple Node.js/Express backend for a basic RAG chat API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "ingest": "node scripts/ingest.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "vitest": "^2.0.5",
    "supertest": "^7.0.0",
    "eslint": "^9.9.0",
    "@eslint/js": "^9.9.0",
    "prettier": "^3.3.3",
    "@vitest/coverage-v8": "^2.0.5",
    "globals": "^15.9.0"
  }
}
